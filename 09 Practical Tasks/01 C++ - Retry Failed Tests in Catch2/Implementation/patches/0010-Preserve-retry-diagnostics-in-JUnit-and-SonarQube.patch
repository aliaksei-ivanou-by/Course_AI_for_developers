diff --git a/src/catch2/reporters/catch_reporter_cumulative_base.cpp b/src/catch2/reporters/catch_reporter_cumulative_base.cpp
index dc5ae4b0..16ebf5df 100644
--- a/src/catch2/reporters/catch_reporter_cumulative_base.cpp
+++ b/src/catch2/reporters/catch_reporter_cumulative_base.cpp
@@ -125,16 +125,31 @@ namespace Catch {
         m_sectionStack.pop_back();
     }
 
+    void CumulativeReporterBase::testCaseAttemptEnded(
+        TestCaseAttemptStats const& attemptStats ) {
+        if ( attemptStats.isFinal ) { return; }
+
+        auto node =
+            Detail::make_unique<TestCaseAttemptNode>( attemptStats );
+        assert( m_sectionStack.empty() );
+        assert( m_rootSection );
+        node->children.push_back( CATCH_MOVE( m_rootSection ) );
+        m_supersededAttempts.push_back( CATCH_MOVE( node ) );
+        m_deepestSection = nullptr;
+    }
+
     void CumulativeReporterBase::testCaseEnded(
         TestCaseStats const& testCaseStats ) {
         auto node = Detail::make_unique<TestCaseNode>( testCaseStats );
         assert( m_sectionStack.size() == 0 );
         node->children.push_back( CATCH_MOVE(m_rootSection) );
+        node->supersededAttempts.swap( m_supersededAttempts );
         m_testCases.push_back( CATCH_MOVE(node) );
 
         assert( m_deepestSection );
         m_deepestSection->stdOut = testCaseStats.stdOut;
         m_deepestSection->stdErr = testCaseStats.stdErr;
+        m_deepestSection = nullptr;
     }
 
 
