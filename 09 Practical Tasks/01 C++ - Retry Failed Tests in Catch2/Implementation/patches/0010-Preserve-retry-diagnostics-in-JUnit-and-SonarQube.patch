+        m_unexpectedExceptionsInAttempt = 0;
+    }
+
     void JunitReporter::assertionEnded( AssertionStats const& assertionStats ) {
-        if( assertionStats.assertionResult.getResultType() == ResultWas::ThrewException && !m_okToFail )
-            unexpectedExceptions++;
+        if ( assertionStats.assertionResult.getResultType() ==
+                 ResultWas::ThrewException &&
+             !m_okToFail ) {
+            if ( m_config->retryFailed() > 0 ) {
+                ++m_unexpectedExceptionsInAttempt;
+            } else {
+                ++unexpectedExceptions;
+            }
+        }
         CumulativeReporterBase::assertionEnded( assertionStats );
     }
 
+    void JunitReporter::testCaseAttemptEnded(
+        TestCaseAttemptStats const& attemptStats ) {
+        if ( attemptStats.isFinal ) {
+            unexpectedExceptions += m_unexpectedExceptionsInAttempt;
+        }
+        m_unexpectedExceptionsInAttempt = 0;
+        CumulativeReporterBase::testCaseAttemptEnded( attemptStats );
+    }
+
     void JunitReporter::testCaseEnded( TestCaseStats const& testCaseStats ) {
         stdOutForSuite += testCaseStats.stdOut;
         stdErrForSuite += testCaseStats.stdErr;
@@ -188,20 +276,28 @@ namespace Catch {
 
