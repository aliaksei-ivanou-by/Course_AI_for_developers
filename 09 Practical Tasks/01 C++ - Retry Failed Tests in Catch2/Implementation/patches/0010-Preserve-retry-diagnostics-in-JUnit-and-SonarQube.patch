@@ -72,6 +72,71 @@ namespace Catch {
             return rss.str();
         }
 
+        bool shouldWriteAssertion( AssertionResult const& result ) {
+            return !result.isOk() ||
+                   result.getResultType() == ResultWas::ExplicitSkip;
+        }
+
+        std::string formatAssertion( AssertionStats const& stats ) {
+            AssertionResult const& result = stats.assertionResult;
+            ReusableStringStream rss;
+            if ( result.getResultType() == ResultWas::ExplicitSkip ) {
+                rss << "SKIPPED\n";
+            } else {
+                rss << "FAILED:\n";
+                if ( result.hasExpression() ) {
+                    rss << "  " << result.getExpressionInMacro() << '\n';
+                }
+                if ( result.hasExpandedExpression() ) {
+                    rss << "with expansion:\n"
+                        << TextFlow::Column( result.getExpandedExpression() )
+                               .indent( 2 )
+                        << '\n';
+                }
+            }
+
+            if ( result.hasMessage() ) { rss << result.getMessage() << '\n'; }
+            for ( auto const& msg : stats.infoMessages ) {
+                if ( msg.type == ResultWas::Info ) {
+                    rss << msg.message << '\n';
+                }
+            }
+
+            rss << "at " << result.getSourceInfo();
+            return rss.str();
+        }
+
+        void appendAssertionDiagnostics(
+            CumulativeReporterBase::SectionNode const& sectionNode,
+            ReusableStringStream& rss ) {
+            for ( auto const& assertionOrBenchmark :
+                  sectionNode.assertionsAndBenchmarks ) {
+                if ( assertionOrBenchmark.isAssertion() ) {
+                    auto const& assertion =
+                        assertionOrBenchmark.asAssertion();
+                    if ( shouldWriteAssertion( assertion.assertionResult ) ) {
+                        rss << formatAssertion( assertion ) << '\n';
+                    }
+                }
+            }
+            for ( auto const& child : sectionNode.childSections ) {
+                appendAssertionDiagnostics( *child, rss );
+            }
+        }
+
+        std::string makeSupersededAttemptOutput(
+            CumulativeReporterBase::TestCaseNode const& testCaseNode ) {
+            ReusableStringStream rss;
+            for ( auto const& attempt :
+                  testCaseNode.supersededAttempts ) {
+                rss << "Attempt " << attempt->value.attemptNumber << " of "
+                    << attempt->value.maxAttempts << " failed:\n";
+                assert( attempt->children.size() == 1 );
+                appendAssertionDiagnostics( *attempt->children.front(), rss );
+            }
+            return rss.str();
+        }
+
         static void normalizeNamespaceMarkers(std::string& str) {
             std::size_t pos = str.find( "::" );
             while ( pos != std::string::npos ) {
@@ -104,18 +169,41 @@ namespace Catch {
