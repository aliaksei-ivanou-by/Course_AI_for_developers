+        std::string sanitizeXmlComment( std::string const& text ) {
+            std::string sanitized;
+            sanitized.reserve( text.size() );
+            for ( char c : text ) {
+                if ( c == '-' && !sanitized.empty() &&
+                     sanitized.back() == '-' ) {
+                    sanitized += ' ';
