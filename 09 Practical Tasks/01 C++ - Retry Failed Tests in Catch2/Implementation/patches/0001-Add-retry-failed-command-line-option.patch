 namespace {
     auto fakeTestCase(const char* name, const char* desc = "") { return Catch::makeTestCaseInfo("", { name, desc }, CATCH_INTERNAL_LINEINFO); }
@@ -398,6 +401,99 @@ TEST_CASE("Parsing sharding-related cli flags", "[sharding]") {
     }
 }
 
+// Tagged [approvals] so that the approval baselines stay unchanged
+TEST_CASE( "Parsing retry-failed cli flag",
+           "[approvals][cli][command-line][retry-failed]" ) {
+    using namespace Catch::Matchers;
+
+    Catch::ConfigData config;
+    auto cli = Catch::makeCommandLineParser( config );
+
+    SECTION( "Defaults to no retries" ) {
+        CHECK( cli.parse( { "test" } ) );
+
+        REQUIRE( config.retryFailed == 0 );
+        Catch::Config cfg( config );
+        Catch::IConfig const& iconfig = cfg;
+        REQUIRE( iconfig.retryFailed() == 0 );
+    }
+
+    SECTION( "Accepted values are stored and visible through IConfig" ) {
+        auto value = GENERATE( as<std::pair<std::string, unsigned int>>{},
+                               std::make_pair( "0", 0u ),
+                               std::make_pair( "1", 1u ),
+                               std::make_pair( "3", 3u ),
+                               std::make_pair( "+3", 3u ),
+                               std::make_pair( "003", 3u ),
+                               std::make_pair( " 3 ", 3u ),
+                               std::make_pair( "4294967295", 4294967295u ) );
+        CAPTURE( value.first );
+
+        CHECK( cli.parse( { "test", "--retry-failed", value.first } ) );
+
+        REQUIRE( config.retryFailed == value.second );
+        Catch::Config cfg( config );
+        Catch::IConfig const& iconfig = cfg;
+        REQUIRE( iconfig.retryFailed() == value.second );
+    }
+
+    SECTION( "The '=' form is accepted" ) {
+        CHECK( cli.parse( { "test", "--retry-failed=2" } ) );
+
+        REQUIRE( config.retryFailed == 2 );
+    }
+
+    SECTION( "Malformed values report an error" ) {
+        auto value = GENERATE( as<std::string>{},
+                               "-1",
+                               "abc",
+                               "1.5",
+                               "1e3",
+                               "0x10",
+                               "4294967296",
+                               "" );
+        CAPTURE( value );
+
+        auto const argument = "--retry-failed=" + value;
+        auto result = cli.parse( { "test", argument } );
+
+        CHECK_FALSE( result );
+        REQUIRE_THAT( result.errorMessage(),
+                      ContainsSubstring( "Could not parse '" + value +
+                                         "' as retry count" ) );
+    }
+
+    SECTION( "Negative value as a separate argument reports an error" ) {
+        auto result = cli.parse( { "test", "--retry-failed", "-1" } );
+
+        CHECK_FALSE( result );
+        REQUIRE_THAT( result.errorMessage(),
+                      ContainsSubstring( "Expected argument following --retry-failed" ) );
+    }
+
+    SECTION( "Missing value reports an error" ) {
+        auto result = cli.parse( { "test", "--retry-failed" } );
+
+        CHECK_FALSE( result );
+        REQUIRE_THAT( result.errorMessage(),
+                      ContainsSubstring( "Expected argument following --retry-failed" ) );
+    }
+
+    SECTION( "Repeating the option reports an error" ) {
+        auto result =
+            cli.parse( { "test", "--retry-failed", "1", "--retry-failed", "2" } );
+
+        CHECK_FALSE( result );
+        REQUIRE_THAT( result.errorMessage(),
+                      ContainsSubstring( "Unrecognised token: --retry-failed" ) );
+    }
+
+    SECTION( "Custom configurations default to no retries" ) {
+        Catch::Config cfg( config );
+        REQUIRE( cfg.Catch::IConfig::retryFailed() == 0 );
+    }
+}
+
