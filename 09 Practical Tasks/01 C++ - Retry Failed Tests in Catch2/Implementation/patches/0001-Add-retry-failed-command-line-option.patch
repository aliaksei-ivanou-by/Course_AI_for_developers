diff --git a/src/catch2/interfaces/catch_interfaces_config.hpp b/src/catch2/interfaces/catch_interfaces_config.hpp
index f52315db..94c6a462 100644
--- a/src/catch2/interfaces/catch_interfaces_config.hpp
