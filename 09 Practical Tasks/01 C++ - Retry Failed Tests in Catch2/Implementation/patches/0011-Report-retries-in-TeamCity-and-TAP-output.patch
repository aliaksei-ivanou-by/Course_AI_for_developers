+        )
+        for attempt in (1, 2):
+            assert "# Attempt {} of 3 failed:".format(attempt) in (
+                tap_exhausted
+            )
+        assert [
+            line
+            for line in tap_exhausted.splitlines()
+            if line.startswith("1..")
+        ] == ["1..1"], tap_exhausted
+
         automake_flaky = run_reporters(
