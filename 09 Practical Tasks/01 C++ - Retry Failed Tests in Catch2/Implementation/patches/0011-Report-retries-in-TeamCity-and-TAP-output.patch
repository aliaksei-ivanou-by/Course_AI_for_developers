From 2844e04efb08d1f1bbd205f431d634d1c69aa4e5 Mon Sep 17 00:00:00 2001
From: Aliaksei Ivanou <aliaksei.ivanou@innowise.com>
Date: Sun, 4 Oct 2026 20:24:06 +0200
Subject: [PATCH] Report retries in TeamCity and TAP output

---
 src/catch2/reporters/catch_reporter_tap.cpp   |  78 ++++++++-
 src/catch2/reporters/catch_reporter_tap.hpp   |  22 +++
 .../reporters/catch_reporter_teamcity.cpp     |  45 ++++-
 .../reporters/catch_reporter_teamcity.hpp     |  14 ++
 tests/TestScripts/testRetryFailed.py          | 155 +++++++++++++++++-
 5 files changed, 305 insertions(+), 9 deletions(-)

diff --git a/src/catch2/reporters/catch_reporter_tap.cpp b/src/catch2/reporters/catch_reporter_tap.cpp
index d7e68bfd..cd4509ae 100644
--- a/src/catch2/reporters/catch_reporter_tap.cpp
+++ b/src/catch2/reporters/catch_reporter_tap.cpp
@@ -12,6 +12,8 @@
 #include <catch2/interfaces/catch_interfaces_config.hpp>
 #include <catch2/catch_test_spec.hpp>
 #include <catch2/reporters/catch_reporter_helpers.hpp>
+#include <catch2/internal/catch_istream.hpp>
+#include <catch2/internal/catch_reusable_string_stream.hpp>
 
 #include <algorithm>
 #include <ostream>
@@ -25,6 +27,15 @@ namespace Catch {
         static constexpr StringRef tapPassedString = "ok"_sr;
         static constexpr Colour::Code tapDimColour = Colour::FileName;
 
+        class TapStringStream final : public IStream {
+        public:
+            std::ostream& stream() override { return m_stream.get(); }
+            std::string str() const { return m_stream.str(); }
+
+        private:
+            ReusableStringStream m_stream;
+        };
+
         class TapAssertionPrinter {
         public:
             TapAssertionPrinter& operator= (TapAssertionPrinter const&) = delete;
@@ -190,6 +201,18 @@ namespace Catch {
             ColourImpl* colourImpl;
         };
 
+        void writeTapDiagnostic( std::ostream& stream,
+                                 std::string const& diagnostic ) {
+            stream << "# ";
+            for ( std::size_t i = 0; i < diagnostic.size(); ++i ) {
+                stream << diagnostic[i];
+                if ( diagnostic[i] == '\n' && i + 1 < diagnostic.size() ) {
+                    stream << "# ";
+                }
+            }
+            stream << '\n';
+        }
+
     } // End anonymous namespace
 
     void TAPReporter::testRunStarting( TestRunInfo const& ) {
@@ -205,15 +228,66 @@ namespace Catch {
     }
 
     void TAPReporter::assertionEnded(AssertionStats const& _assertionStats) {
+        if ( m_config->retryFailed() > 0 ) {
+            static_cast<void>(
+                _assertionStats.assertionResult.getExpandedExpression() );
+            m_bufferedAssertions.emplace_back(
+                _assertionStats,
+                static_cast<std::string>( currentTestCaseInfo->name ) );
+            return;
+        }
+
+        BufferedAssertion assertion(
+            _assertionStats,
+            static_cast<std::string>( currentTestCaseInfo->name ) );
+        printAssertion( assertion, m_colour.get() );
+    }
+
+    void TAPReporter::printAssertion( BufferedAssertion const& assertion,
+                                      ColourImpl* colour ) {
         ++counter;
 
-        m_stream << "# " << currentTestCaseInfo->name << '\n';
-        TapAssertionPrinter printer(m_stream, _assertionStats, counter, m_colour.get());
+        m_stream << "# " << assertion.testName << '\n';
+        TapAssertionPrinter printer(
+            m_stream, assertion.stats, counter, colour );
         printer.print();
 
         m_stream << '\n' << std::flush;
     }
 
+    void TAPReporter::testCaseAttemptStarting( TestCaseAttemptInfo const& ) {
+        m_bufferedAssertions.clear();
+    }
+
+    void TAPReporter::testCaseAttemptEnded(
+        TestCaseAttemptStats const& attemptStats ) {
+        if ( attemptStats.isFinal ) {
+            for ( auto const& assertion : m_bufferedAssertions ) {
+                printAssertion( assertion, m_colour.get() );
+            }
+        } else {
+            auto diagnosticCounter = counter;
+            for ( auto const& assertion : m_bufferedAssertions ) {
+                TapStringStream diagnostic;
+                auto noColour =
+                    makeColourImpl( ColourMode::None, &diagnostic );
+                diagnostic.stream() << assertion.testName << '\n';
+                TapAssertionPrinter printer( diagnostic.stream(),
+                                             assertion.stats,
+                                             ++diagnosticCounter,
+                                             noColour.get() );
+                printer.print();
+
+                m_stream << "# Attempt " << attemptStats.attemptNumber
+                         << " of " << attemptStats.maxAttempts
+                         << " failed:\n";
+                writeTapDiagnostic( m_stream, diagnostic.str() );
+            }
+        }
+        m_bufferedAssertions.clear();
+        m_stream.flush();
+    }
+
     void TAPReporter::testRunEnded(TestRunStats const& _testRunStats) {
         m_stream << "1.." << _testRunStats.totals.assertions.total();
         if (_testRunStats.totals.testCases.total() == 0) {
diff --git a/src/catch2/reporters/catch_reporter_tap.hpp b/src/catch2/reporters/catch_reporter_tap.hpp
index 4664928f..56f1165d 100644
--- a/src/catch2/reporters/catch_reporter_tap.hpp
+++ b/src/catch2/reporters/catch_reporter_tap.hpp
@@ -11,6 +11,9 @@
 #include <catch2/reporters/catch_reporter_streaming_base.hpp>
 #include <catch2/internal/catch_move_and_forward.hpp>
 
+#include <string>
+#include <vector>
+
 namespace Catch {
 
     class TAPReporter final : public StreamingReporterBase {
@@ -32,10 +35,29 @@ namespace Catch {
 
         void assertionEnded(AssertionStats const& _assertionStats) override;
 
+        void testCaseAttemptStarting(
+            TestCaseAttemptInfo const& attemptInfo ) override;
+
+        void testCaseAttemptEnded(
+            TestCaseAttemptStats const& attemptStats ) override;
+
         void testRunEnded(TestRunStats const& _testRunStats) override;
 
     private:
+        struct BufferedAssertion {
+            BufferedAssertion( AssertionStats const& _stats,
+                               std::string _testName ):
+                stats( _stats ), testName( CATCH_MOVE( _testName ) ) {}
+
+            AssertionStats stats;
+            std::string testName;
+        };
+
+        void printAssertion( BufferedAssertion const& assertion,
+                             ColourImpl* colour );
+
         std::size_t counter = 0;
+        std::vector<BufferedAssertion> m_bufferedAssertions;
     };
 
 } // end namespace Catch
diff --git a/src/catch2/reporters/catch_reporter_teamcity.cpp b/src/catch2/reporters/catch_reporter_teamcity.cpp
index 38aa55a6..0e1cac48 100644
--- a/src/catch2/reporters/catch_reporter_teamcity.cpp
+++ b/src/catch2/reporters/catch_reporter_teamcity.cpp
@@ -115,16 +115,25 @@ namespace Catch {
                     "  " << result.getExpandedExpression() << '\n';
             }
 
+            ReusableStringStream serviceMessage;
             if ( result.getResultType() == ResultWas::ExplicitSkip ) {
-                m_stream << "##teamcity[testIgnored";
+                serviceMessage << "##teamcity[testIgnored";
             } else if ( currentTestCaseInfo->okToFail() ) {
                 msg << "- failure ignore as test marked as 'ok to fail'\n";
-                m_stream << "##teamcity[testIgnored";
+                serviceMessage << "##teamcity[testIgnored";
             } else {
-                m_stream << "##teamcity[testFailed";
+                serviceMessage << "##teamcity[testFailed";
+            }
+            serviceMessage
+                << " name='" << escape( currentTestCaseInfo->name ) << '\''
+                << " message='" << escape( msg.str() ) << '\'' << "]\n";
+
+            if ( m_config->retryFailed() > 0 ) {
+                m_bufferedAssertions.push_back(
+                    { serviceMessage.str(), msg.str() } );
+            } else {
+                m_stream << serviceMessage.str();
             }
-            m_stream << " name='" << escape( currentTestCaseInfo->name ) << '\''
-                     << " message='" << escape( msg.str() ) << '\'' << "]\n";
         }
         m_stream.flush();
     }
@@ -137,6 +146,32 @@ namespace Catch {
         m_stream.flush();
     }
 
+    void TeamCityReporter::testCaseAttemptStarting(
+        TestCaseAttemptInfo const& ) {
+        m_bufferedAssertions.clear();
+    }
+
+    void TeamCityReporter::testCaseAttemptEnded(
+        TestCaseAttemptStats const& attemptStats ) {
+        if ( attemptStats.isFinal ) {
+            for ( auto const& assertion : m_bufferedAssertions ) {
+                m_stream << assertion.serviceMessage;
+            }
+        } else {
+            for ( auto const& assertion : m_bufferedAssertions ) {
+                ReusableStringStream diagnostic;
+                diagnostic << "Attempt " << attemptStats.attemptNumber
+                           << " of " << attemptStats.maxAttempts
+                           << " failed:\n" << assertion.diagnostic;
+                m_stream << "##teamcity[testStdErr name='"
+                         << escape( currentTestCaseInfo->name ) << "' out='"
+                         << escape( diagnostic.str() ) << "']\n";
+            }
+        }
+        m_bufferedAssertions.clear();
+        m_stream.flush();
+    }
+
     void TeamCityReporter::testCaseEnded(TestCaseStats const& testCaseStats) {
         StreamingReporterBase::testCaseEnded(testCaseStats);
         auto const& testCaseInfo = *testCaseStats.testInfo;
