+            colour_mode="ansi",
+            expected_stdout="immediate execution=1\n",
+        )
+        tap_enabled = run_reporter(
+            test_exe,
+            output_dir,
+            "TAP",
+            "tap-no-retry-enabled",
+            ("--retry-failed", "1"),
