         assert sonar_hyphen_root.findall(".//error") == []
 
+        teamcity_omitted = run_reporter(
+            test_exe,
+            output_dir,
+            "TeamCity",
+            "teamcity-no-retry-omitted",
+            test_spec="[.retry-immediate]",
+        )
+        teamcity_enabled = run_reporter(
+            test_exe,
+            output_dir,
+            "TeamCity",
+            "teamcity-no-retry-enabled",
+            ("--retry-failed", "1"),
+            "[.retry-immediate]",
+        )
+        assert normalize_teamcity_durations(
+            teamcity_enabled
+        ) == normalize_teamcity_durations(teamcity_omitted), (
+            teamcity_omitted,
+            teamcity_enabled,
+        )
+
+        teamcity_flaky = run_reporter(
+            test_exe,
+            output_dir,
+            "TeamCity",
+            "teamcity-flaky",
+            ("--retry-failed", "2"),
+            "[.retry-fail-once]",
+        )
+        assert "##teamcity[testFailed" not in teamcity_flaky, teamcity_flaky
+        assert teamcity_flaky.count("Attempt 1 of 3 failed:") == 1, (
+            teamcity_flaky
+        )
+        assert (
+            "##teamcity[testStdErr name='retry fail once' "
+            "out='Attempt 1 of 3 failed:"
+        ) in teamcity_flaky, teamcity_flaky
+
+        teamcity_exhausted = run_reporter(
+            test_exe,
+            output_dir,
+            "TeamCity",
+            "teamcity-exhausted",
+            ("--retry-failed", "2"),
+            "[.retry-always-fails]",
+            42,
+        )
+        assert teamcity_exhausted.count("##teamcity[testFailed") == 1, (
+            teamcity_exhausted
+        )
+        for attempt in (1, 2):
+            assert teamcity_exhausted.count(
+                "##teamcity[testStdErr name='retry always fails' "
+                "out='Attempt {} of 3 failed:".format(attempt)
+            ) == 1, teamcity_exhausted
+
+        tap_omitted = run_reporter(
