From 5669b8e64e6e86fcbd269e7d2c4aadf5745acd8d Mon Sep 17 00:00:00 2001
From: Aliaksei Ivanou <aliaksei.ivanou@innowise.com>
Date: Mon, 5 Oct 2026 08:30:01 +0200
Subject: [PATCH] Report final retry outcomes in human reporters

---
 extras/catch_amalgamated.cpp                  |  28 ++++-
 extras/catch_amalgamated.hpp                  |   2 +-
 .../reporters/catch_reporter_compact.cpp      |  13 +-
 .../reporters/catch_reporter_console.cpp      |  13 +-
 tests/ExtraTests/X96-RetryFailed.cpp          |  18 +++
 tests/TestScripts/testRetryFailed.py          | 111 ++++++++++++++++++
 6 files changed, 175 insertions(+), 10 deletions(-)

diff --git a/extras/catch_amalgamated.cpp b/extras/catch_amalgamated.cpp
index bc3be188..4b0cee27 100644
--- a/extras/catch_amalgamated.cpp
+++ b/extras/catch_amalgamated.cpp
@@ -7,7 +7,7 @@
 // SPDX-License-Identifier: BSL-1.0
 
 //  Catch v3.16.0
-//  Generated: 2026-10-05 08:08:04.858157
+//  Generated: 2026-10-05 08:27:55.682821
 //  ----------------------------------------------------------
 //  This file is an amalgamation of multiple different files.
 //  You probably shouldn't edit it directly.
@@ -9798,14 +9798,23 @@ private:
             if ( testCaseStats.attemptCount > 1 ) {
                 m_stream << "Test case '" << testCaseStats.testInfo->name
                          << "' ";
-                if ( testCaseStats.isFlaky ) {
+                auto const& finalOutcome = testCaseStats.totals.testCases;
+                if ( finalOutcome.passed > 0 ) {
                     m_stream << "passed on attempt "
                              << testCaseStats.attemptCount << " of "
                              << testCaseStats.maxAttempts << " (flaky)\n";
-                } else {
+                } else if ( finalOutcome.failed > 0 ) {
                     m_stream << "failed after " << testCaseStats.attemptCount
                              << " of " << testCaseStats.maxAttempts
                              << " attempts\n";
+                } else if ( finalOutcome.skipped > 0 ) {
+                    m_stream << "was skipped on attempt "
+                             << testCaseStats.attemptCount << " of "
+                             << testCaseStats.maxAttempts << '\n';
+                } else if ( finalOutcome.failedButOk > 0 ) {
+                    m_stream << "failed as expected on attempt "
+                             << testCaseStats.attemptCount << " of "
+                             << testCaseStats.maxAttempts << '\n';
                 }
                 m_stream << std::flush;
             }
@@ -10342,12 +10351,21 @@ void ConsoleReporter::testCaseEnded(TestCaseStats const& _testCaseStats) {
     m_tablePrinter->close();
     if ( _testCaseStats.attemptCount > 1 ) {
         m_stream << "Test case '" << _testCaseStats.testInfo->name << "' ";
-        if ( _testCaseStats.isFlaky ) {
+        auto const& finalOutcome = _testCaseStats.totals.testCases;
+        if ( finalOutcome.passed > 0 ) {
             m_stream << "passed on attempt " << _testCaseStats.attemptCount
                      << " of " << _testCaseStats.maxAttempts << " (flaky)\n";
-        } else {
+        } else if ( finalOutcome.failed > 0 ) {
             m_stream << "failed after " << _testCaseStats.attemptCount
                      << " of " << _testCaseStats.maxAttempts << " attempts\n";
+        } else if ( finalOutcome.skipped > 0 ) {
+            m_stream << "was skipped on attempt "
+                     << _testCaseStats.attemptCount << " of "
+                     << _testCaseStats.maxAttempts << '\n';
+        } else if ( finalOutcome.failedButOk > 0 ) {
+            m_stream << "failed as expected on attempt "
+                     << _testCaseStats.attemptCount << " of "
+                     << _testCaseStats.maxAttempts << '\n';
         }
         m_stream << std::flush;
     }
