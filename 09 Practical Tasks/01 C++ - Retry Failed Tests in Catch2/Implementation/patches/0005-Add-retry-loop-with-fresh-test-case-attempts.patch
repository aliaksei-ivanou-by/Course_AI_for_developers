     Totals RunContext::runTest(TestCaseHandle const& testCase) {
-        updateTotalsFromAtomics();
-        const Totals prevTotals = m_totals;
-
         auto const& testInfo = testCase.getTestCaseInfo();
         m_reporter->testCaseStarting(testInfo);
 
+        auto const retryCount = m_config->retryFailed();
+        auto const maxAttempts =
+            static_cast<std::uint64_t>( retryCount ) + 1;
+        std::uint64_t retriesUsed = 0;
         std::uint64_t testRuns = 0;
-        auto attemptResult = runTestAttempt( testCase, prevTotals, testRuns );
+        Totals finalTotals;
+        std::string redirectedCout;
+        std::string redirectedCerr;
+
+        while ( true ) {
+            updateTotalsFromAtomics();
+            const Totals totalsAtAttemptStart = m_totals;
+            const Counts assertionsAtAttemptStart = getAssertionCounts();
+            const std::uint64_t attemptNumber = retriesUsed + 1;
+
+            if ( retryCount > 0 ) {
+                m_reporter->testCaseAttemptStarting( TestCaseAttemptInfo(
+                    testInfo, attemptNumber, maxAttempts ) );
+            }
+
+            auto attemptResult = runTestAttempt(
+                testCase, totalsAtAttemptStart, testRuns );
+            finalTotals = attemptResult.totals;
+            redirectedCout += attemptResult.stdOut;
+            redirectedCerr += attemptResult.stdErr;
+
+            const bool retry =
+                attemptResult.totals.testCases.failed > 0 &&
+                retriesUsed < retryCount && !aborting();
+
+            if ( retryCount > 0 ) {
+                m_reporter->testCaseAttemptEnded( TestCaseAttemptStats(
+                    testInfo,
+                    attemptNumber,
+                    maxAttempts,
+                    attemptResult.totals,
+                    CATCH_MOVE( attemptResult.stdOut ),
+                    CATCH_MOVE( attemptResult.stdErr ),
+                    aborting(),
+                    !retry ) );
+            }
+
+            if ( !retry ) { break; }
+
+            setAssertionCounts( assertionsAtAttemptStart );
+            updateTotalsFromAtomics();
+            ++retriesUsed;
+        }
 
-        m_totals.testCases += attemptResult.totals.testCases;
-        m_reporter->testCaseEnded(
-            TestCaseStats( testInfo,
-                           attemptResult.totals,
-                           CATCH_MOVE( attemptResult.stdOut ),
-                           CATCH_MOVE( attemptResult.stdErr ),
-                           aborting() ) );
+        m_totals.testCases += finalTotals.testCases;
+        auto testCaseStats = TestCaseStats( testInfo,
+                                            finalTotals,
+                                            CATCH_MOVE( redirectedCout ),
+                                            CATCH_MOVE( redirectedCerr ),
+                                            aborting() );
+        testCaseStats.attemptCount = retriesUsed + 1;
+        testCaseStats.maxAttempts = maxAttempts;
+        testCaseStats.isFlaky =
+            retriesUsed > 0 && finalTotals.testCases.passed > 0;
+        m_reporter->testCaseEnded( testCaseStats );
 
         m_activeTestCase = nullptr;
         m_testCaseTracker = nullptr;
 
-        return attemptResult.totals;
+        return finalTotals;
     }
 
