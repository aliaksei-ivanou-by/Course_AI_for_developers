+def event_lines(output, prefix, test_name=None):
+    lines = [line for line in output.splitlines() if line.startswith(prefix)]
+    if test_name is not None:
+        marker = 'name="{}"'.format(test_name)
+        lines = [line for line in lines if marker in line]
+    return lines
+
+
+def assert_attempts(
+    output,
+    test_name,
+    attempt_numbers,
+    max_attempts,
+    flaky,
+    passed,
+):
+    starts = event_lines(output, "test-case-attempt-starting ", test_name)
+    ends = event_lines(output, "test-case-attempt-ended ", test_name)
+    expected = [(number, max_attempts) for number in attempt_numbers]
+
+    def numbers(line):
+        match = re.search(r" attempt=(\d+)/(\d+)", line)
+        assert match is not None, line
+        return tuple(int(value) for value in match.groups())
+
+    assert [numbers(line) for line in starts] == expected, output
+    assert [numbers(line) for line in ends] == expected, output
+    assert all(" final=false " in line for line in ends[:-1]), output
+    assert " final=true " in ends[-1], output
+
+    test_ends = event_lines(output, "test-case-ended ", test_name)
+    assert len(test_ends) == 1, output
+    final_line = test_ends[0]
+    assert "attempts={}/{} flaky={}".format(
+        attempt_numbers[-1], max_attempts, str(flaky).lower()
+    ) in final_line, final_line
+    expected_counts = (
+        "test-cases={passed=1,failed=0"
+        if passed
+        else "test-cases={passed=0,failed=1"
+    )
+    assert expected_counts in final_line, final_line
+
+
+def part_numbers(output, test_name):
