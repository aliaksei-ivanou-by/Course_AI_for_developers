diff --git a/tests/ExtraTests/X96-RetryFailed.cpp b/tests/ExtraTests/X96-RetryFailed.cpp
index 7b637df2..ffc109ce 100644
--- a/tests/ExtraTests/X96-RetryFailed.cpp
+++ b/tests/ExtraTests/X96-RetryFailed.cpp
@@ -550,6 +550,24 @@ TEST_CASE( "retry missing assertions then passes",
 TEST_CASE( "retry missing assertions always fails",
            "[.retry-no-assertions-always]" ) {}
 
+TEST_CASE( "retry junit multiple passing assertions",
+           "[.retry-junit-multiple-passes]" ) {
+    CHECK( true );
+    CHECK( true );
+    CHECK( true );
+}
+
+TEST_CASE( "retry junit multiple failing assertions",
+           "[.retry-junit-multiple-failures]" ) {
+    CHECK( false );
+    CHECK( false );
+    CHECK( false );
+}
+
+TEST_CASE( "retry junit final error", "[.retry-junit-final-error]" ) {
+    throw std::runtime_error( "final junit error" );
+}
+
 TEST_CASE( "retry independent X", "[.retry-independent]" ) {
     ++independentXExecutions;
     std::cout << "independent-X execution=" << independentXExecutions << '\n';
diff --git a/tests/TestScripts/testRetryFailed.py b/tests/TestScripts/testRetryFailed.py
index 718d02fa..0a1efeb6 100644
--- a/tests/TestScripts/testRetryFailed.py
+++ b/tests/TestScripts/testRetryFailed.py
@@ -1373,6 +1373,63 @@ def main():
         assert "Attempt 1 of 3 failed:" in junit_exhausted_out.text
         assert "Attempt 2 of 3 failed:" in junit_exhausted_out.text
 
+        junit_multiple_passes = run_reporter(
+            test_exe,
+            output_dir,
+            "JUnit",
+            "junit-multiple-passes",
+            ("--retry-failed", "1"),
+            "[.retry-junit-multiple-passes]",
+        )
+        junit_multiple_passes_suite = only_junit_suite(
+            junit_multiple_passes
+        )
+        assert junit_multiple_passes_suite.get("errors") == "0"
+        assert junit_multiple_passes_suite.get("failures") == "0"
+        assert junit_multiple_passes_suite.get("skipped") == "0"
+        assert junit_multiple_passes_suite.get("tests") == "1"
+        assert len(junit_multiple_passes_suite.findall("./testcase")) == 1
+        assert junit_multiple_passes_suite.findall(".//failure") == []
+        assert junit_multiple_passes_suite.findall(".//error") == []
+
+        junit_multiple_failures = run_reporter(
+            test_exe,
+            output_dir,
+            "JUnit",
+            "junit-multiple-failures",
+            ("--retry-failed", "1"),
+            "[.retry-junit-multiple-failures]",
+            42,
+        )
+        junit_multiple_failures_suite = only_junit_suite(
+            junit_multiple_failures
+        )
+        assert junit_multiple_failures_suite.get("errors") == "0"
+        assert junit_multiple_failures_suite.get("failures") == "1"
+        assert junit_multiple_failures_suite.get("skipped") == "0"
+        assert junit_multiple_failures_suite.get("tests") == "1"
+        assert len(junit_multiple_failures_suite.findall("./testcase")) == 1
+        assert len(junit_multiple_failures_suite.findall(".//failure")) == 1
+        assert junit_multiple_failures_suite.findall(".//error") == []
+
+        junit_final_error = run_reporter(
+            test_exe,
+            output_dir,
+            "JUnit",
+            "junit-final-error",
+            ("--retry-failed", "1"),
+            "[.retry-junit-final-error]",
+            42,
+        )
+        junit_final_error_suite = only_junit_suite(junit_final_error)
+        assert junit_final_error_suite.get("errors") == "1"
+        assert junit_final_error_suite.get("failures") == "0"
+        assert junit_final_error_suite.get("skipped") == "0"
+        assert junit_final_error_suite.get("tests") == "1"
+        assert len(junit_final_error_suite.findall("./testcase")) == 1
+        assert junit_final_error_suite.findall(".//failure") == []
+        assert len(junit_final_error_suite.findall(".//error")) == 1
+
         junit_throw_once = run_reporter(
             test_exe,
             output_dir,
