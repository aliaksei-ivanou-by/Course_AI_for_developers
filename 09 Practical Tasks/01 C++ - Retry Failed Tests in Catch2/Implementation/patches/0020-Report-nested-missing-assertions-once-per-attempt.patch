+        tap_nested_flaky_lines = tap_nested_flaky.splitlines()
+        assert [
+            line
+            for line in tap_nested_flaky_lines
+            if line.startswith(("ok ", "not ok "))
+        ] == ["ok 1 - true", "ok 2 - true"], tap_nested_flaky
+        assert tap_nested_flaky_lines.count(
+            "# Attempt 1 of 3 failed:"
+        ) == 1, tap_nested_flaky
+        assert "# " + nested_reason in tap_nested_flaky_lines
+        assert [
+            line for line in tap_nested_flaky_lines if line.startswith("1..")
