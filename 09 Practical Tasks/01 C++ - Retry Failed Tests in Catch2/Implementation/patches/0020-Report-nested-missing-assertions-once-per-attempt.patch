+        assert tap_nested_always_lines.count(
+            "# Attempt 1 of 2 failed:"
+        ) == 1, tap_nested_always
+        assert "# " + nested_reason in tap_nested_always_lines
+        assert [
+            line for line in tap_nested_always_lines if line.startswith("1..")
