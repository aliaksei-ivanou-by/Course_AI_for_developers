+TEST_CASE( "retry nested sections missing assertions then passes",
+           "[.retry-nested-no-assertions-flaky]" ) {
+    SECTION( "outer" ) {
+        SECTION( "inner with assertion" ) { CHECK( true ); }
+        SECTION( "inner without assertion" ) {
+            ++nestedNoAssertionsFlakyExecutions;
+            if ( nestedNoAssertionsFlakyExecutions >= 2 ) { CHECK( true ); }
+        }
+    }
+}
+
+TEST_CASE( "retry nested sections missing assertions always fails",
