+        assert junit_nested_always.get("tests") == "1"
+        assert junit_nested_always.get("failures") == "1"
+        assert junit_nested_always.get("errors") == "0"
+        junit_nested_failures = junit_nested_always.findall(".//failure")
+        assert len(junit_nested_failures) == 1, junit_nested_always_output
+        assert junit_nested_failures[0].get("type") == "NoAssertions"
+        assert (
+            junit_nested_failures[0].get("message")
+            == "no assertions in section"
+        ), junit_nested_always_output
+        assert nested_reason in (junit_nested_failures[0].text or "")
+        junit_nested_always_out = "".join(
