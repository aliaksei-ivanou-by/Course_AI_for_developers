+        # Missing assertions in a nested leaf section, not in the test case
+        # itself. Exhausted and fail-then-pass runs, for the recorder and
+        # for every reporter that reports assertion-free failures.
+        nested_flaky_name = (
+            "retry nested sections missing assertions then passes"
+        )
+        nested_always_name = (
+            "retry nested sections missing assertions always fails"
+        )
+        nested_reason = "No assertions in section 'inner without assertion'"
+        nested_flaky = run_retry_scenario(
+            test_exe,
+            output_dir,
+            "nested-noassert-flaky",
+            "[.retry-nested-no-assertions-flaky]",
+            2,
+            extra_arguments=("-w", "NoAssertions"),
+        )
+        assert_attempts(
+            nested_flaky, nested_flaky_name, [1, 2], 3, True, True
+        )
+        nested_always = run_retry_scenario(
+            test_exe,
+            output_dir,
+            "nested-noassert-always",
+            "[.retry-nested-no-assertions-always]",
+            1,
+            42,
+            extra_arguments=("-w", "NoAssertions"),
+        )
+        assert_attempts(
+            nested_always, nested_always_name, [1, 2], 2, False, False
+        )
+        for line in event_lines(
+            nested_always, "test-case-attempt-ended ", nested_always_name
+        ):
+            assert "assertions={passed=1,failed=1" in line, line
+
+        junit_nested_flaky = only_junit_suite(
+            run_reporter(
+                test_exe,
+                output_dir,
+                "JUnit",
+                "junit-nested-noassert-flaky",
+                ("--retry-failed", "2"),
+                "[.retry-nested-no-assertions-flaky]",
+                extra_arguments=("-w", "NoAssertions"),
+            )
+        )
+        assert junit_nested_flaky.get("tests") == "1"
+        assert junit_nested_flaky.get("failures") == "0"
+        assert junit_nested_flaky.get("errors") == "0"
+        assert junit_nested_flaky.findall(".//failure") == []
+        junit_nested_flaky_out = "".join(
+            element.text or ""
