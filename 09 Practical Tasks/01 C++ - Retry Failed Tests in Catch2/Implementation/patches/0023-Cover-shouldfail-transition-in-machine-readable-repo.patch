From 0e402b57615b7775951bc87eca7f02fe29a54a6b Mon Sep 17 00:00:00 2001
From: Aliaksei Ivanou <aliaksei.ivanou@innowise.com>
Date: Mon, 5 Oct 2026 09:58:01 +0200
Subject: [PATCH] Cover shouldfail transition in machine-readable reporters

Check that a [!shouldfail] test whose first attempt passes unexpectedly and whose retry fails as expected is reported as an accepted failure, with the superseded reason kept, by the XML, JSON, JUnit, SonarQube, TeamCity, TAP, and Automake reporters. Record the coverage and its validation in the implementation notes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GunDRycct3rWzK5p7dpZxP
---
 IMPLEMENTATION_NOTES.md              |  20 ++-
 tests/TestScripts/testRetryFailed.py | 176 +++++++++++++++++++++++++++
 2 files changed, 195 insertions(+), 1 deletion(-)

diff --git a/IMPLEMENTATION_NOTES.md b/IMPLEMENTATION_NOTES.md
index 959834b9..02aa4213 100644
--- a/IMPLEMENTATION_NOTES.md
+++ b/IMPLEMENTATION_NOTES.md
@@ -232,7 +232,7 @@ tree `8c8ac8df7cde538ceeb80dd299baec31103bf847`, matching commit `30ab6617`.
 
 ### Follow-up coverage
 
-Three areas that the review listed as unverified now have automated checks:
+Four areas that the review listed as unverified now have automated checks:
 
 - Missing assertions in a nested leaf section, exhausted and fail-then-pass,
   for the recorder, JUnit, SonarQube, TeamCity, and TAP. The new checks found
@@ -249,6 +249,10 @@ Three areas that the review listed as unverified now have automated checks:
   `CATCH_BREAK_INTO_DEBUGGER`, because the break happens inside the library.
   Every failed assertion breaks, including those of superseded attempts, and
   the break happens inside its attempt.
+- A `[!shouldfail]` test whose first attempt passes unexpectedly and whose
+  retry fails as expected, for XML, JSON, JUnit, SonarQube, TeamCity, TAP, and
+  Automake. Every reporter reports the accepted final outcome and keeps the
+  reason of the superseded attempt; no code change was needed.
 
 `RetryFailed::Fatal` now runs serially, waits up to 120 seconds for each
 crashing child instead of 20, and prints how long each child took. Its single
@@ -281,6 +285,20 @@ taking 43 to 63 seconds for its 18 crashing children. On Linux the same test
 takes under a second, which suggests that most of the Windows time is spent
 in the operating system's crash handling.
 
+The `[!shouldfail]` transition checks changed only
+`tests/TestScripts/testRetryFailed.py`. They passed on Linux and on Windows,
+where the incremental `all-tests` build recompiled nothing:
+
+```powershell
+cmake -B C:\build\Course_AI\catch2\debug-build -S . -DCMAKE_BUILD_TYPE=Debug --preset all-tests
+cmake --build C:\build\Course_AI\catch2\debug-build --config Debug --parallel
+ctest --test-dir C:\build\Course_AI\catch2\debug-build -C Debug --output-on-failure -R 'RetryFailed::Scenarios'
+ctest --test-dir C:\build\Course_AI\catch2\debug-build -C Debug --output-on-failure -j 4
+```
+
+Results: focused 1/1 and `all-tests` 158/158, with no build warnings and no
+`*.unapproved.txt` files.
+
 ## 9. Known limitations and unsupported cases
 
 - Catch2 does not roll back test-owned or external state: globals, statics,
diff --git a/tests/TestScripts/testRetryFailed.py b/tests/TestScripts/testRetryFailed.py
index 0aee2baa..bfae73d9 100644
--- a/tests/TestScripts/testRetryFailed.py
+++ b/tests/TestScripts/testRetryFailed.py
@@ -2223,6 +2223,182 @@ def main():
             line for line in tap_nested_always_lines if line.startswith("1..")
         ] == ["1..2"], tap_nested_always
 
+        # [!shouldfail]: attempt 1 passes unexpectedly (a failure, so it is
+        # retried) and attempt 2 fails as expected (an accepted failure).
+        # Every machine-readable reporter must report the accepted final
+        # outcome and keep the reason of the superseded attempt.
+        transition_name = "retry shouldfail pass then expected failure"
+        transition_spec = "[.retry-shouldfail-transition]"
+        transition_reason = (
+            "Test case passed but was expected to fail ([!shouldfail])"
+        )
+
+        xml_transition = ET.fromstring(
+            run_reporter(
+                test_exe,
+                output_dir,
+                "XML",
+                "xml-shouldfail-transition",
+                ("--retry-failed", "2"),
+                transition_spec,
+            )
+        )
+        xml_transition_attempts = xml_transition.findall("./TestCase/Attempt")
+        assert [
+            (
+                attempt.get("number"),
+                attempt.find("./AttemptResult").get("success"),
+                attempt.find("./AttemptResult").get("final"),
+            )
+            for attempt in xml_transition_attempts
+        ] == [("1", "false", "false"), ("2", "true", "true")]
+        xml_transition_overall = xml_transition.find(
+            "./TestCase/OverallResult"
+        )
+        assert xml_transition_overall.get("success") == "true"
+        assert xml_transition_overall.get("attempts") == "2"
+        assert xml_transition_overall.get("flaky") == "false"
+        xml_transition_cases = xml_transition.find("./OverallResultsCases")
+        assert xml_transition_cases.get("failures") == "0"
+        assert xml_transition_cases.get("expectedFailures") == "1"
+
+        json_transition = json.loads(
+            run_reporter(
+                test_exe,
+                output_dir,
+                "JSON",
+                "json-shouldfail-transition",
+                ("--retry-failed", "2"),
+                transition_spec,
+            )
+        )
+        json_transition_run = json_transition["test-run"]
+        assert json_transition_run["totals"]["test-cases"] == {
+            "passed": 0,
+            "failed": 0,
+            "fail-but-ok": 1,
+            "skipped": 0,
+        }, json_transition_run["totals"]
+        json_transition_attempts = json_transition_run["test-cases"][0][
+            "attempts"
+        ]
+        assert json_transition_attempts["used"] == 2
+        assert json_transition_attempts["flaky"] is False
+        assert [
+            (result["attempt"], result["final"])
+            for result in json_transition_attempts["results"]
+        ] == [(1, False), (2, True)]
+        assert (
+            json_transition_attempts["results"][0]["totals"]["assertions"][
+                "failed"
+            ]
+            == 1
+        )
+        assert (
+            json_transition_attempts["results"][1]["totals"]["assertions"][
+                "fail-but-ok"
+            ]
+            == 1
+        )
+
+        junit_transition_output = run_reporter(
+            test_exe,
+            output_dir,
+            "JUnit",
+            "junit-shouldfail-transition",
+            ("--retry-failed", "2"),
+            transition_spec,
+        )
+        junit_transition = only_junit_suite(junit_transition_output)
+        assert junit_transition.get("tests") == "1"
+        assert junit_transition.get("failures") == "0"
+        assert junit_transition.get("errors") == "0"
+        assert junit_transition.get("skipped") == "1"
+        assert junit_transition.findall(".//failure") == []
+        assert junit_transition.findall(".//error") == []
+        assert len(junit_transition.findall(".//skipped")) == 1
+        junit_transition_out = "".join(
+            element.text or ""
+            for element in junit_transition.findall("./testcase/system-out")
+        )
+        assert junit_transition_out.count("Attempt 1 of 3 failed:") == 1
+        assert transition_reason in junit_transition_out
+
+        (
+            sonar_transition_root,
+            sonar_transition_comments,
+        ) = parse_sonarqube(
+            run_reporter(
+                test_exe,
+                output_dir,
+                "SonarQube",
+                "sonar-shouldfail-transition",
+                ("--retry-failed", "2"),
+                transition_spec,
+            )
+        )
+        assert sonar_transition_root.findall(".//failure") == []
+        assert sonar_transition_root.findall(".//error") == []
+        assert len(sonar_transition_root.findall(".//skipped")) == 1
+        assert len(sonar_transition_comments) == 1
+        assert "Attempt 1 of 3 failed:" in sonar_transition_comments[0]
+        assert transition_reason in sonar_transition_comments[0]
+
+        teamcity_transition = run_reporter(
+            test_exe,
+            output_dir,
+            "TeamCity",
+            "teamcity-shouldfail-transition",
+            ("--retry-failed", "2"),
+            transition_spec,
+        )
+        assert "##teamcity[testFailed" not in teamcity_transition
+        assert teamcity_transition.count(
+            "##teamcity[testIgnored name='{}'".format(transition_name)
+        ) == 1, teamcity_transition
+        assert teamcity_transition.count(
+            "##teamcity[testStdErr name='{}'".format(transition_name)
+        ) == 1, teamcity_transition
+        assert "Attempt 1 of 3 failed:" in teamcity_transition
+        assert (
+            "Test case passed but was expected to fail (|[!shouldfail|])"
+            in teamcity_transition
+        ), teamcity_transition
+
+        tap_transition_lines = run_reporter(
+            test_exe,
+            output_dir,
+            "TAP",
+            "tap-shouldfail-transition",
+            ("--retry-failed", "2"),
+            transition_spec,
+        ).splitlines()
+        tap_transition_points = [
+            line
+            for line in tap_transition_lines
+            if line.startswith(("ok ", "not ok "))
+        ]
+        assert len(tap_transition_points) == 1, tap_transition_lines
+        assert tap_transition_points[0].startswith("not ok 1 - ")
+        assert tap_transition_points[0].endswith(" # TODO accepted failure")
+        assert tap_transition_lines.count("# Attempt 1 of 3 failed:") == 1
+        assert "# " + transition_reason in tap_transition_lines
+        assert [
+            line for line in tap_transition_lines if line.startswith("1..")
+        ] == ["1..1"], tap_transition_lines
+
+        automake_transition = run_reporter(
+            test_exe,
+            output_dir,
+            "Automake",
+            "automake-shouldfail-transition",
+            ("--retry-failed", "2"),
+            transition_spec,
+        )
+        assert automake_transition.splitlines() == [
+            ":test-result: XFAIL " + transition_name
+        ], automake_transition
+
         tap_mayfail = run_reporter(
             test_exe,
             output_dir,
