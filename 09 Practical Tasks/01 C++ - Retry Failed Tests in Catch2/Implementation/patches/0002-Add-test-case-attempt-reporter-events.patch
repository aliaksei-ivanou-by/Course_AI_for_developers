+// Tagged [approvals] so that the approval baselines stay unchanged
+TEST_CASE( "Multireporter forwards attempt events to listeners, then reporters",
+           "[approvals][reporters][multi-reporter][retry-failed]" ) {
+    Catch::Config config( Catch::ConfigData{} );
+    auto testInfo = Catch::makeTestCaseInfo(
+        "", { "retried test", "[tag]" }, CATCH_INTERNAL_LINEINFO );
+
+    // Reporters are added before listeners, to check that listeners are
+    // called first anyway.
+    Catch::MultiReporter multiReporter( &config );
+    std::vector<std::string> records;
+    multiReporter.addReporter( Catch::Detail::make_unique<AttemptMockReporter>(
+        "reporter-1", records, makeDummyRepConfig( config ) ) );
+    multiReporter.addListener( Catch::Detail::make_unique<AttemptMockListener>(
+        "listener-1", records, &config ) );
+    multiReporter.addListener( Catch::Detail::make_unique<AttemptMockListener>(
+        "listener-2", records, &config ) );
+    multiReporter.addReporter( Catch::Detail::make_unique<AttemptMockReporter>(
+        "reporter-2", records, makeDummyRepConfig( config ) ) );
+
+    SECTION( "Attempt start" ) {
+        multiReporter.testCaseAttemptStarting(
+            Catch::TestCaseAttemptInfo( *testInfo, 2, 3 ) );
+
+        std::vector<std::string> expected{
+            "listener-1 starting retried test 2/3",
+            "listener-2 starting retried test 2/3",
+            "reporter-1 starting retried test 2/3",
+            "reporter-2 starting retried test 2/3" };
+        REQUIRE( records == expected );
+    }
+    SECTION( "Attempt end" ) {
+        Catch::Totals totals;
+        totals.assertions.failed = 1;
+        multiReporter.testCaseAttemptEnded( Catch::TestCaseAttemptStats(
+            *testInfo, 1, 3, totals, "out", "err", false, false ) );
+
+        std::vector<std::string> expected{
+            "listener-1 ended retried test 1/3 failed=1 out=out err=err retry",
+            "listener-2 ended retried test 1/3 failed=1 out=out err=err retry",
+            "reporter-1 ended retried test 1/3 failed=1 out=out err=err retry",
+            "reporter-2 ended retried test 1/3 failed=1 out=out err=err retry" };
+        REQUIRE( records == expected );
+    }
+    SECTION( "Final attempt end" ) {
+        multiReporter.testCaseAttemptEnded( Catch::TestCaseAttemptStats(
+            *testInfo, 3, 3, Catch::Totals{}, "", "", true, true ) );
+
+        std::vector<std::string> expected{
+            "listener-1 ended retried test 3/3 failed=0 out= err= aborting final",
+            "listener-2 ended retried test 3/3 failed=0 out= err= aborting final",
+            "reporter-1 ended retried test 3/3 failed=0 out= err= aborting final",
+            "reporter-2 ended retried test 3/3 failed=0 out= err= aborting final" };
+        REQUIRE( records == expected );
+    }
+}
+
+// Tagged [approvals] so that the approval baselines stay unchanged
+TEST_CASE( "Attempt events and fields are optional for existing reporters",
+           "[approvals][reporters][retry-failed]" ) {
+    Catch::Config config( Catch::ConfigData{} );
+    auto testInfo = Catch::makeTestCaseInfo(
+        "", { "retried test", "[tag]" }, CATCH_INTERNAL_LINEINFO );
+    Catch::TestCaseAttemptInfo const attemptInfo( *testInfo, 1, 2 );
+    Catch::TestCaseAttemptStats const attemptStats(
+        *testInfo, 1, 2, Catch::Totals{}, "", "", false, true );
+
+    SECTION( "Direct IEventListener implementations get the default no-op" ) {
+        PreAttemptEventsReporter reporter( &config );
+        Catch::IEventListener& listener = reporter;
+
+        REQUIRE_NOTHROW( listener.testCaseAttemptStarting( attemptInfo ) );
+        REQUIRE_NOTHROW( listener.testCaseAttemptEnded( attemptStats ) );
+    }
+    SECTION( "Multireporter mixes reporters with and without overrides" ) {
+        std::vector<std::string> records;
+        Catch::MultiReporter multiReporter( &config );
+        multiReporter.addReporter(
+            Catch::Detail::make_unique<PreAttemptEventsReporter>( &config ) );
+        multiReporter.addListener( Catch::Detail::make_unique<AttemptMockListener>(
+            "listener", records, &config ) );
+
+        multiReporter.testCaseAttemptStarting( attemptInfo );
+        multiReporter.testCaseAttemptEnded( attemptStats );
+
+        std::vector<std::string> expected{
+            "listener starting retried test 1/2",
+            "listener ended retried test 1/2 failed=0 out= err= final" };
+        REQUIRE( records == expected );
+    }
+    SECTION( "TestCaseStats built with the existing constructor" ) {
+        Catch::TestCaseStats stats(
+            *testInfo, Catch::Totals{}, std::string(), std::string(), false );
+
+        REQUIRE( stats.attemptCount == 1 );
+        REQUIRE( stats.maxAttempts == 1 );
+        REQUIRE_FALSE( stats.isFlaky );
+    }
+    SECTION( "Attempt numbers are 64-bit" ) {
+        std::uint64_t const beyondUInt32 = 4294967296ULL;
+        Catch::TestCaseAttemptInfo const largest(
+            *testInfo, beyondUInt32, beyondUInt32 );
+
+        REQUIRE( largest.attemptNumber == beyondUInt32 );
+        REQUIRE( largest.maxAttempts == beyondUInt32 );
+    }
+}
+
 namespace {
