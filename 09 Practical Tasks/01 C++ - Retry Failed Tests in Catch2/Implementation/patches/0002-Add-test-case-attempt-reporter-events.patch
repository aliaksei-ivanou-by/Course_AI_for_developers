+namespace {
+    std::string describeAttempt( std::string const& witness,
+                                 char const* event,
+                                 Catch::TestCaseInfo const* testInfo,
+                                 std::uint64_t attemptNumber,
+                                 std::uint64_t maxAttempts ) {
+        return witness + ' ' + event + ' ' + testInfo->name + ' ' +
+               std::to_string( attemptNumber ) + '/' +
+               std::to_string( maxAttempts );
+    }
+
+    std::string describeAttemptEnd( std::string const& witness,
+                                    Catch::TestCaseAttemptStats const& stats ) {
+        return describeAttempt( witness,
+                                "ended",
+                                stats.testInfo,
+                                stats.attemptNumber,
+                                stats.maxAttempts ) +
+               " failed=" + std::to_string( stats.totals.assertions.failed ) +
+               " out=" + stats.stdOut + " err=" + stats.stdErr +
+               ( stats.aborting ? " aborting" : "" ) +
+               ( stats.isFinal ? " final" : " retry" );
+    }
+
+    // A listener that records the attempt events it receives
+    class AttemptMockListener : public Catch::EventListenerBase {
+        std::string m_witness;
+        std::vector<std::string>& m_recorder;
+    public:
+        AttemptMockListener( std::string witness,
+                             std::vector<std::string>& recorder,
+                             Catch::IConfig const* config ):
+            EventListenerBase( config ),
+            m_witness( CATCH_MOVE( witness ) ),
+            m_recorder( recorder ) {}
+
+        void testCaseAttemptStarting(
+            Catch::TestCaseAttemptInfo const& attemptInfo ) override {
+            m_recorder.push_back( describeAttempt( m_witness,
+                                                   "starting",
+                                                   attemptInfo.testInfo,
+                                                   attemptInfo.attemptNumber,
+                                                   attemptInfo.maxAttempts ) );
+        }
+        void testCaseAttemptEnded(
+            Catch::TestCaseAttemptStats const& attemptStats ) override {
+            m_recorder.push_back( describeAttemptEnd( m_witness, attemptStats ) );
+        }
+    };
+    // A reporter that records the attempt events it receives
+    class AttemptMockReporter : public Catch::StreamingReporterBase {
+        std::string m_witness;
+        std::vector<std::string>& m_recorder;
+    public:
+        AttemptMockReporter( std::string witness,
+                             std::vector<std::string>& recorder,
+                             Catch::ReporterConfig&& config ):
+            StreamingReporterBase( CATCH_MOVE( config ) ),
+            m_witness( CATCH_MOVE( witness ) ),
+            m_recorder( recorder ) {}
+
+        void testCaseAttemptStarting(
+            Catch::TestCaseAttemptInfo const& attemptInfo ) override {
+            m_recorder.push_back( describeAttempt( m_witness,
+                                                   "starting",
+                                                   attemptInfo.testInfo,
+                                                   attemptInfo.attemptNumber,
+                                                   attemptInfo.maxAttempts ) );
+        }
+        void testCaseAttemptEnded(
+            Catch::TestCaseAttemptStats const& attemptStats ) override {
+            m_recorder.push_back( describeAttemptEnd( m_witness, attemptStats ) );
+        }
+    };
+
