+        run_fatal_child(junit_command)
         junit_output = junit_path.read_text(encoding="utf-8")
         junit_root = ET.fromstring(junit_output)
         assert junit_root.tag == "testsuites", junit_output
@@ -104,6 +257,8 @@ def main():
         assert len(suites[0].findall(".//error")) == 1, junit_output
         assert "Attempt 2 of 3" not in junit_output, junit_output
 
