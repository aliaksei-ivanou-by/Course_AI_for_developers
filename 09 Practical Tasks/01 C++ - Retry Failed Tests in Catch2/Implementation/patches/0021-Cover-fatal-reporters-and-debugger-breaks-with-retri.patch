@@ -686,6 +686,28 @@ add_test(
 set_tests_properties(RetryFailed::Fatal
   PROPERTIES
     LABELS "uses-python;uses-signals"
+    # Every child process crashes on purpose. Running alone keeps the
+    # operating system's crash handling from competing with parallel tests.
