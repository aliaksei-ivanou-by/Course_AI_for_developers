+
 namespace {
 
     std::string escapeOutput( std::string const& value ) {
@@ -83,6 +88,7 @@ namespace {
         Catch::TestCaseInfo const* m_testCase = nullptr;
         bool m_attemptOpen = false;
         bool m_partialRunOpen = false;
+        bool m_fatalErrorEncountered = false;
         std::uint64_t m_attemptNumber = 0;
         std::uint64_t m_maxAttempts = 0;
         std::uint64_t m_partNumber = 0;
@@ -172,6 +178,15 @@ namespace {
             m_stream << '\n';
         }
 
+        void fatalErrorEncountered( Catch::StringRef message ) override {
+            CATCH_ENFORCE( m_testCase && m_attemptOpen && m_partialRunOpen,
+                           "retry-recorder observed a fatal error outside an attempt" );
+            m_fatalErrorEncountered = true;
+            m_stream << "fatal-error-encountered message=\""
+                     << escapeOutput( static_cast<std::string>( message ) )
+                     << "\"\n";
+        }
+
         void testCasePartialEnded( Catch::TestCaseStats const& stats,
                                    std::uint64_t partNumber ) override {
             enforceTestCase( stats.testInfo );
@@ -187,7 +202,9 @@ namespace {
         void testCaseAttemptEnded(
             Catch::TestCaseAttemptStats const& stats ) override {
             enforceTestCase( stats.testInfo );
-            CATCH_ENFORCE( m_attemptOpen && !m_partialRunOpen,
+            CATCH_ENFORCE( m_attemptOpen &&
+                               ( !m_partialRunOpen ||
+                                 m_fatalErrorEncountered ),
                            "retry-recorder received an unmatched attempt end" );
             CATCH_ENFORCE( m_attemptNumber == stats.attemptNumber &&
                                m_maxAttempts == stats.maxAttempts,
@@ -200,8 +217,11 @@ namespace {
                      << " listener-starts=" << attemptListenerCounts.starts
                      << " listener-ends=" << attemptListenerCounts.ends;
             writeStats( m_stream, stats );
+            if ( m_fatalErrorEncountered ) { m_stream << " fatal=true"; }
             m_stream << '\n';
             m_attemptOpen = false;
+            m_partialRunOpen = false;
+            m_fatalErrorEncountered = false;
         }
 
         void testCaseEnded( Catch::TestCaseStats const& stats ) override {
@@ -234,6 +254,7 @@ namespace {
             writeCounts( m_stream, stats.totals.testCases );
             m_stream << "} aborting="
                      << ( stats.aborting ? "true" : "false" ) << '\n';
+            m_stream.flush();
             StreamingReporterBase::testRunEnded( stats );
         }
     };
@@ -682,3 +703,13 @@ TEST_CASE( "retry shard D", "[.retry-shard]" ) {
     ++shardDExecutions;
     CHECK( shardDExecutions >= 2 );
 }
+
+TEST_CASE( "retry fatal condition", "[.retry-fatal]" ) {
+    SECTION( "fatal section" ) {
+#if defined( _MSC_VER )
+        RaiseException( 0xC0000005, 0, 0, nullptr );
+#else
+        std::raise( SIGILL );
+#endif
+    }
+}
diff --git a/tests/TestScripts/testRetryFailedFatal.py b/tests/TestScripts/testRetryFailedFatal.py
new file mode 100644
index 00000000..b60ce960
--- /dev/null
+++ b/tests/TestScripts/testRetryFailedFatal.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+
+#              Copyright Catch2 Authors
+# Distributed under the Boost Software License, Version 1.0.
+#   (See accompanying file LICENSE.txt or copy at
+#        https://www.boost.org/LICENSE_1_0.txt)
+
+# SPDX-License-Identifier: BSL-1.0
+
+"""Checks retry attempt events on Catch2's fatal-error path."""
+
+import subprocess
+import sys
+
+
+def event_lines(output, prefix):
+    return [line for line in output.splitlines() if line.startswith(prefix)]
+
+
+def main():
+    test_exe, = sys.argv[1:]
+    command = [
+        test_exe,
+        "[.retry-fatal]",
+        "--retry-failed",
+        "2",
+        "--reporter",
+        "retry-recorder",
+        "--colour-mode",
+        "none",
+    ]
+    result = subprocess.run(
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=20,
+        check=False,
+        universal_newlines=True,
+    )
+    assert result.returncode != 0, (
+        "Fatal child unexpectedly exited successfully:\n{}".format(command)
+    )
+
+    output = result.stdout
+    starts = event_lines(output, "test-case-attempt-starting ")
+    ends = event_lines(output, "test-case-attempt-ended ")
+    test_ends = event_lines(output, "test-case-ended ")
+    run_ends = event_lines(output, "test-run-ended ")
+    fatal_events = event_lines(output, "fatal-error-encountered ")
+
+    assert len(starts) == 1 and "attempt=1/3" in starts[0], output
+    assert len(fatal_events) == 1, output
+    assert len(ends) == 1 and "attempt=1/3" in ends[0], output
+    assert "assertions={passed=0,failed=1,failed-but-ok=0,skipped=0}" in ends[0]
+    assert "aborting=false final=true" in ends[0], ends[0]
+    assert ends[0].endswith("fatal=true"), ends[0]
+    assert len(test_ends) == 1, output
+    assert "attempts=1/3 flaky=false" in test_ends[0], test_ends[0]
+    assert len(run_ends) == 1, output
+    assert "test-cases={passed=0,failed=1" in run_ends[0], run_ends[0]
+    assert "attempt=2/3" not in output, output
+
+    lines = output.splitlines()
+    assert lines.index(starts[0]) < lines.index(fatal_events[0])
+    assert lines.index(fatal_events[0]) < lines.index(ends[0])
+    assert lines.index(ends[0]) < lines.index(test_ends[0])
+    assert lines.index(test_ends[0]) < lines.index(run_ends[0])
+
+
+if __name__ == "__main__":
+    sys.exit(main())
