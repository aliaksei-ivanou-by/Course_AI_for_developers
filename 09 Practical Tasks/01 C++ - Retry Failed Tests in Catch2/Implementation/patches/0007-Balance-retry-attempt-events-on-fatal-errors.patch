--- a/tests/ExtraTests/X96-RetryFailed.cpp
+++ b/tests/ExtraTests/X96-RetryFailed.cpp
@@ -21,11 +21,16 @@
 #include <catch2/reporters/catch_reporter_registrars.hpp>
 #include <catch2/reporters/catch_reporter_streaming_base.hpp>
 
+#include <csignal>
 #include <cstdint>
 #include <iostream>
 #include <string>
 #include <utility>
 
