From aceaeea120175ef7e3ee1e2346a173bcceee9586 Mon Sep 17 00:00:00 2001
From: Aliaksei Ivanou <aliaksei.ivanou@innowise.com>
Date: Sun, 4 Oct 2026 19:45:43 +0200
Subject: [PATCH] Balance retry attempt events on fatal errors

Track the active retry attempt in RunContext and emit its final attempt-end event before the existing fatal-path test-case and run endings. Preserve the fatal path one-failure totals and expose the active attempt metadata on TestCaseStats.

Add a platform-guarded child-process crash scenario that verifies one balanced attempt, fatal ordering, no retry, and the existing JUnit crash path.

Tests: phase6-validate.ps1 T07 basic (92/92) and all (157/157).
---
 src/catch2/internal/catch_run_context.cpp | 28 +++++++--
 src/catch2/internal/catch_run_context.hpp |  2 +
 tests/ExtraTests/CMakeLists.txt           | 11 ++++
 tests/ExtraTests/X96-RetryFailed.cpp      | 33 ++++++++++-
 tests/TestScripts/testRetryFailedFatal.py | 71 +++++++++++++++++++++++
 5 files changed, 139 insertions(+), 6 deletions(-)
 create mode 100644 tests/TestScripts/testRetryFailedFatal.py

diff --git a/src/catch2/internal/catch_run_context.cpp b/src/catch2/internal/catch_run_context.cpp
index 2dd7b782..6a3fb09b 100644
--- a/src/catch2/internal/catch_run_context.cpp
+++ b/src/catch2/internal/catch_run_context.cpp
@@ -378,6 +378,8 @@ namespace Catch {
             const std::uint64_t attemptNumber = retriesUsed + 1;
 
             if ( retryCount > 0 ) {
+                m_activeTestCaseAttempt = attemptNumber;
+                m_maxTestCaseAttempts = maxAttempts;
                 m_reporter->testCaseAttemptStarting( TestCaseAttemptInfo(
                     testInfo, attemptNumber, maxAttempts ) );
             }
@@ -402,6 +404,8 @@ namespace Catch {
                     CATCH_MOVE( attemptResult.stdErr ),
                     aborting(),
                     !retry ) );
+                m_activeTestCaseAttempt = 0;
+                m_maxTestCaseAttempts = 0;
             }
 
             if ( !retry ) { break; }
@@ -779,11 +783,25 @@ namespace Catch {
         Totals deltaTotals;
         deltaTotals.testCases.failed = 1;
         deltaTotals.assertions.failed = 1;
-        m_reporter->testCaseEnded(TestCaseStats(testInfo,
-                                  deltaTotals,
-                                  std::string(),
-                                  std::string(),
-                                  false));
+        auto testCaseStats = TestCaseStats( testInfo,
+                                            deltaTotals,
+                                            std::string(),
+                                            std::string(),
+                                            false );
+        if ( m_activeTestCaseAttempt > 0 ) {
+            m_reporter->testCaseAttemptEnded( TestCaseAttemptStats(
+                testInfo,
+                m_activeTestCaseAttempt,
+                m_maxTestCaseAttempts,
+                deltaTotals,
+                std::string(),
+                std::string(),
+                false,
+                true ) );
+            testCaseStats.attemptCount = m_activeTestCaseAttempt;
+            testCaseStats.maxAttempts = m_maxTestCaseAttempts;
+        }
+        m_reporter->testCaseEnded( testCaseStats );
         m_totals.testCases.failed++;
         updateTotalsFromAtomics();
         m_reporter->testRunEnded(TestRunStats(m_runInfo, m_totals, false));
diff --git a/src/catch2/internal/catch_run_context.hpp b/src/catch2/internal/catch_run_context.hpp
index d9f13e44..38b3f65b 100644
--- a/src/catch2/internal/catch_run_context.hpp
+++ b/src/catch2/internal/catch_run_context.hpp
@@ -149,6 +149,8 @@ namespace Catch {
         mutable Detail::Mutex m_assertionMutex;
         TestRunInfo m_runInfo;
         TestCaseHandle const* m_activeTestCase = nullptr;
+        std::uint64_t m_activeTestCaseAttempt = 0;
+        std::uint64_t m_maxTestCaseAttempts = 0;
         ITracker* m_testCaseTracker = nullptr;
         Optional<AssertionResult> m_lastResult;
         IConfig const* m_config;
