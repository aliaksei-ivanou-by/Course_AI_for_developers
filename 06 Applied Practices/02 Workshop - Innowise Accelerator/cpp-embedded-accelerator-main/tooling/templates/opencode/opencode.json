{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "secrets/**": "deny",
      "**/secrets/**": "deny",
      "credentials/**": "deny",
      "**/credentials/**": "deny",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      ".aws/**": "deny",
      "**/.aws/**": "deny",
      ".azure/**": "deny",
      "**/.azure/**": "deny",
      ".kube/**": "deny",
      "**/.kube/**": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*private*key*": "deny",
      "**/credentials.json": "deny",
      "**/credentials.yaml": "deny",
      "**/credentials.yml": "deny",
      "**/credentials.toml": "deny"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "pwd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "cmake --build *": "allow",
      "ctest *": "allow",
      "ninja *": "allow",
      "make *": "allow",
      "sudo*": "deny",
      "cat *.env*": "deny",
      "cat *id_rsa*": "deny",
      "cat *id_dsa*": "deny",
      "cat *id_ecdsa*": "deny",
      "cat *id_ed25519*": "deny",
      "cat *secrets*": "deny",
      "cat *credentials*": "deny",
      "rm -rf*": "deny",
      "chmod 777*": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push --force-with-lease*": "deny",
      "git push -f*": "deny",
      "git push * -f*": "deny",
      "dd * of=/dev/*": "deny",
      "nrfjprog * --recover*": "deny",
      "west * erase*": "deny",
      "openocd * mass_erase*": "deny",
      "cmake --build *flash*": "ask",
      "cmake --build *erase*": "ask",
      "cmake --build *program*": "ask",
      "ninja *flash*": "ask",
      "ninja *erase*": "ask",
      "ninja *program*": "ask",
      "make *flash*": "ask",
      "make *erase*": "ask",
      "make *program*": "ask"
    },
    "task": {
      "*": "ask"
    },
    "skill": {
      "*": "allow"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".worktrees/**",
      "build/**",
      "out/**",
      "cmake-build-*/**",
      "**/CMakeFiles/**",
      "**/*.o",
      "**/*.obj",
      "**/*.a",
      "**/*.lib",
      "**/*.so",
      "**/*.dll",
      "**/*.elf",
      "**/*.bin",
      "**/*.hex"
    ]
  }
}
